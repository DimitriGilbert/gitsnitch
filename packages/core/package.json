{
  "name": "@git-snitch/core",
  "version": "0.0.7",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./report-data": {
      "types": "./src/report-data.ts",
      "default": "./dist/report-data.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.0.3",
    "sanitize-html": "^2.17.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@git-snitch/config": "workspace:*",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
