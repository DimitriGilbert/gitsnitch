{
  "name": "@git-snitch/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "git-snitch": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "pnpm --filter @git-snitch/renderer build && vitest run"
  },
  "dependencies": {
    "@git-snitch/core": "workspace:*",
    "@git-snitch/renderer": "workspace:*",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@git-snitch/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
